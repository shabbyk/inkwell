# Rust — pattern is UNANCHORED on purpose. The crate lives in server/, so the build
# directory is server/target/. A leading slash would anchor it to the repo root and miss it.
target/
**/*.rs.bk

# Node — unanchored for the same reason.
node_modules/
dist/
.vite/
*.tsbuildinfo

# Notes data — NEVER COMMIT. Contains real private notes.
# Unanchored so it matches regardless of which directory the server runs from.
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Secrets
.env
.env.*
!.env.example

# Exported backups (may contain private notes)
*.zip

# Local git worktrees (task delegation)
docs/specs-worktree/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
